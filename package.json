{
  "name": "www.elliotjreed.com",
  "author": "Elliot J. Reed",
  "description": "Dependencies and configuration for www.elliotjreed.com, the personal website of Elliot J. Reed.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && bun run amp/build-amp.ts",
    "build:amp": "bun run amp/build-amp.ts",
    "test:amp": "bun run amp/build-amp.ts",
    "deploy": "bun run build && wrangler deploy",
    "wrangler": "wrangler deploy",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "format": "prettier --log-level=warn --write .",
    "test": "vitest run",
    "test:full": "vitest run --reporter=dot",
    "test:ci": "vitest run --reporter=github-actions",
    "test:watch:ui": "vitest watch --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tailwindcss/typography": "^0.5.20",
    "fuse.js": "^7.5.0",
    "isbot": "^5.2.2",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@elliotjreed/vitest-minimal-reporter": "^1.1.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/amphtml-validator": "^1.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "amphtml-validator": "^1.0.38",
    "autoprefixer": "^10.6.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
