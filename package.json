{
  "name": "www.elliotjreed.com",
  "author": "Elliot J. Reed",
  "description": "Dependencies and configuration for www.elliotjreed.com, the personal website of Elliot J. Reed.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && bun run amp/build-amp.ts",
    "build:amp": "bun run amp/build-amp.ts",
    "test:amp": "bun run amp/build-amp.ts",
    "deploy": "bun run build && wrangler deploy",
    "wrangler": "wrangler deploy",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "format": "prettier --log-level=warn --write .",
    "test": "vitest run",
    "test:full": "vitest run --reporter=dot",
    "test:ci": "vitest run --reporter=github-actions",
    "test:watch:ui": "vitest watch --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@react-router/node": "^7.17.0",
    "@react-router/serve": "^7.17.0",
    "@tailwindcss/typography": "^0.5.20",
    "fuse.js": "^7.4.2",
    "isbot": "^5.1.42",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260608.1",
    "@elliotjreed/vitest-minimal-reporter": "^1.1.0",
    "@react-router/dev": "^7.17.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/amphtml-validator": "^1.0.4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "amphtml-validator": "^1.0.38",
    "autoprefixer": "^10.5.0",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  }
}
